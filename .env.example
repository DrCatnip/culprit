# Copy this file to .env and fill in your values. Never commit .env.

# Nebius Token Factory API key
NEBIUS_API_KEY=your-key-here

# Your Nebius project ID. The Python SDK reads the first name, the contree CLI the second.
NEBIUS_PROJECT_ID=your-project-id
NEBIUS_AI_PROJECT=your-project-id

# Optional overrides (defaults shown). Model IDs are case-sensitive: run `culprit doctor`.
# CULPRIT_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# CULPRIT_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# CULPRIT_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# CULPRIT_PARALLEL=8
# CULPRIT_IMAGE=python:3.12-slim
# CULPRIT_PROBE_TIMEOUT=300
# CULPRIT_SETUP_TIMEOUT=900
# CULPRIT_MAX_TEST_ATTEMPTS=3
